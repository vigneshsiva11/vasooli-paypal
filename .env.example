# ---------------------------------------------------------------------------
# Vasooli — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Vasooli
# Environment: 'development' or 'production'.
# In production (ENVIRONMENT=production OR RENDER is set):
# Startup refuses to run unless PUBLIC_DEMO=true and ADMIN_TOKEN is non-empty.
# Security flags (PUBLIC_DEMO, ADMIN_TOKEN) fail closed when empty/blank.
ENVIRONMENT=development
# Default currency: INR (default, unchanged Razorpay behavior) or USD
DEFAULT_CURRENCY=INR

# Public-demo guard & Privileged route access control
# When PUBLIC_DEMO=true, all write requests (non-GET/HEAD/OPTIONS) require header
# X-Admin-Token matching ADMIN_TOKEN via constant-time comparison.
# Exception: POST /webhooks/paypal bypasses the token check (protected by PayPal signature verification).
# If PUBLIC_DEMO=true and ADMIN_TOKEN is empty, writes fail closed with HTTP 503.
# GET endpoints remain public. CORS allows only the comma-separated origins in CORS_ORIGINS.
# Privileged routes (/demo/reset, /demo/scenarios/*, /sim/advance, /orchestrator/*)
# verify X-Admin-Token via dependency whenever ADMIN_TOKEN is configured or the app
# is in production (constant-time compare; 503 if unset in production), independent of PUBLIC_DEMO.
PUBLIC_DEMO=false
ADMIN_TOKEN=
CORS_ORIGINS=
# Public demo automated runs (default false; 403 otherwise).
# When enabled, allows unauthenticated POST /demo/public/run in sandbox mode.
PUBLIC_RUNS=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vasooli

# Google Gemini — used only for DIAGNOSIS/RECOMMENDATION, never for execution
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Timeout for a diagnosis call.
GEMINI_TIMEOUT_SECONDS=20
# Separate, shorter budget for the GET / reachability probe.
GEMINI_HEALTH_TIMEOUT_SECONDS=4
# How long a reachability observation is trusted before it is re-checked.
GEMINI_HEALTH_TTL_SECONDS=60

# Razorpay (test mode only — keep working alongside PayPal)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayPal (sandbox) — Phase 2 / PayPal AI Hackathon
# All values from https://developer.paypal.com/dashboard/
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from Dashboard > My Apps & Credentials > Webhooks (fill in after creating webhook)
PAYPAL_WEBHOOK_ID=
# Sandbox buyer account email (from sandbox test accounts)
PAYPAL_BUYER_EMAIL=
